# Canonical site URL — required in Vercel Production for correct
# sitemap.xml, robots.txt, Open Graph and canonical/hreflang links.
# Example after buying a domain: https://khlegends.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Search Console → HTML-tag verification → paste only the
# content="..." token (not the whole meta tag).
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Optional: Yandex Webmaster meta verification token.
# NEXT_PUBLIC_YANDEX_VERIFICATION=
